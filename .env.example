# Required: create this with BotFather and set it in Railway Variables.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Optional: comma-separated chat IDs for fixed recipients. You can instead use /start in Telegram.
TELEGRAM_CHAT_IDS=

# Optional: seconds between result-page checks. Minimum is 300 seconds.
CHECK_INTERVAL_SECONDS=900

# Optional: seconds between live-status messages. Minimum is 3600 seconds (one hour).
HEARTBEAT_INTERVAL_SECONDS=3600

# Optional: persistent state path. Railway Volume users may set this to /data/state.json.
STATE_FILE=state.json

# Catalog bot options (used only when starting catalog_bot.py).
# Minimum scan interval is 900 seconds; default is 3600 seconds.
CATALOG_SCAN_INTERVAL_SECONDS=3600
# Sends a live-status message automatically; minimum is 3600 seconds.
CATALOG_HEARTBEAT_INTERVAL_SECONDS=3600
CATALOG_REQUEST_DELAY_SECONDS=0.2
CATALOG_STATE_FILE=catalog_state.json
